{
  "name": "frost-slide",
  "private": true,
  "version": "1.0.0",
  "description": "Frost Slide, the downhill sled racer, on three.js. Ships to iOS with Capacitor.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sweep": "tsx scripts/sweep.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "catalog:snapshot": "tsx scripts/catalog-snapshot.ts",
    "trace": "tsx scripts/trace.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/native-purchases": "^8.8.1",
    "@fontsource/nunito": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "@telemetrydeck/sdk": "^2.0.4",
    "canvas-confetti": "^1.9.4",
    "lucide-preact": "^1.48.0",
    "preact": "^10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@types/three": "0.186.0",
    "eslint": "^10.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
